# Copy to .env and fill in real values. Never commit .env itself.

# Must be byte-for-byte the same Base64 string as `jwt.secret` in
# backend/src/main/resources/application.yml - Spring issues the tokens,
# this service only verifies them.
JWT_SECRET=
JWT_ALGORITHM=HS256

# Needs s3:GetObject on the bucket Spring uploads to (AWS_S3_BUCKET in
# backend/src/main/resources/application.yml). A read-only IAM user is enough.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2

# Comma-separated origins the React app is served from.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
