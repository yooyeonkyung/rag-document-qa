# Copy to .env and fill in real values. Never commit .env itself.

# Must be byte-for-byte the same Base64 string as `jwt.secret` in
# backend/src/main/resources/application.yml - Spring issues the tokens,
# this service only verifies them.
JWT_SECRET=
JWT_ALGORITHM=HS256

# Gemini API key (https://aistudio.google.com/apikey) - used for both
# embeddings and the chat model.
GOOGLE_API_KEY=

# Optional RAG overrides (defaults live in app/rag/config.py)
# EMBEDDING_MODEL=gemini-embedding-001
# LLM_MODEL=gemini-3.5-flash
# LLM_MAX_RETRIES=2
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=150
# RETRIEVER_K=5
# HISTORY_MAX_TURNS=3
# PRIORITY_PAGES=500
# SEGMENT_PAGES=50

# Not needed until the S3/Spring integration step.
# Needs s3:GetObject on the bucket Spring uploads to (AWS_S3_BUCKET in
# backend/src/main/resources/application.yml). A read-only IAM user is enough.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2

# Comma-separated origins the React app is served from.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
